embed-server --server-config=standalone.xml

/subsystem=elytron/key-store=httpsKS:add(path=${jboss.home.dir}/standalone/configuration/wildfly.p12,credential-reference={clear-text=changeit},type=PKCS12)
/subsystem=elytron/key-manager=httpsKM:add(key-store=httpsKS,credential-reference={clear-text=changeit})
/subsystem=elytron/server-ssl-context=httpsSSC:add(key-manager=httpsKM,protocols=["TLSv1.2","TLSv1.3"])
/subsystem=undertow/server=default-server/https-listener=https:add(socket-binding=https,ssl-context=httpsSSC,max-post-size=1048576)

/subsystem=undertow/server=default-server/http-listener=http:remove()

stop-embedded-server
